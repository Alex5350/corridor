@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<section class="login-panel">
    <h1>Error.</h1>
    <p class="intro">An error occurred while processing your request.</p>

    @if (Model.ShowRequestId)
    {
        <p>Request ID: <code>@Model.RequestId</code></p>
    }

    <p>Try the operation again. If the problem repeats, the Corridor runbook (docs/runbook.md) lists the demo service ports and restart commands.</p>
</section>
