  <con:testSuite id="2ff4ab24d40c4a559947" name="Identity modes">
    <con:description>The dual-trust story on the wire: a Groovy step mints the okta-sim service JWT for the legacy client, the first call carries it in cor:Security and succeeds, and the deliberate bad-token call must come back as a cor:InvalidToken SOAP fault (HTTP 500).</con:description>
    <con:settings/>
    <con:surrogateChars>?</con:surrogateChars>
    <con:runType>SEQUENTIAL</con:runType>
    <con:testCase id="ca78ffa1362b4cad8b8c" keepService="true" name="JWT path and bad token path" searchProperties="true">
      <con:settings/>
      <con:testStep type="groovy" name="Fetch service JWT" id="f8d82d0ef6cd4fb8ae34">
        <con:settings/>
        <con:config>import groovy.json.JsonSlurper

// Fetch a service JWT from okta-sim with the legacy client credentials and store it
// on the project so both suites can expand ${#Project#jwt} inside cor:Security.
def connection = new URL('http://localhost:8080/token').openConnection()
def basic = 'legacy:corridor-legacy-secret'.getBytes('UTF-8').encodeBase64().toString()
connection.setRequestProperty('Authorization', 'Basic ' + basic)
connection.setRequestProperty('Content-Type', 'application/x-www-form-urlencoded')
connection.setRequestMethod('POST')
connection.setDoOutput(true)
connection.getOutputStream().write('grant_type=client_credentials'.getBytes('UTF-8'))
def payload = connection.getInputStream().getText()
def token = new JsonSlurper().parseText(payload).access_token
assert token : 'okta-sim returned no access token for the legacy client'
testRunner.testCase.testSuite.project.setPropertyValue('jwt', token)
log.info 'Stored a fresh service JWT (kid rotates, so fetch it per run)' </con:config>
      </con:testStep>
