<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- CoreWCF hosts the TraceLink SOAP 1.1 service inside ASP.NET Core. -->
    <PackageReference Include="CoreWCF.Http" Version="1.9.1" />
    <PackageReference Include="CoreWCF.Primitives" Version="1.9.1" />
    <!-- Data access is raw ADO.NET on purpose: no Dapper, no EF, no micro-ORM in this service. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.6" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- SignedXml (enveloped SAML signature check) ships in the shared framework, no package needed. -->
  </ItemGroup>

</Project>
