<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is null ? "PermitPortal" : $"{ViewData["Title"]} | PermitPortal")</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="shell header-inner">
            <div class="brand">
                <a class="brand-link" asp-page="/Index">PermitPortal</a>
                <span class="brand-sub">Corridor import permit program</span>
            </div>
            <nav class="site-nav" aria-label="Primary">
                <a asp-page="/Index">Home</a>
                <a asp-page="/Permits/Index">Permits</a>
                <a asp-page="/Cases/Index">Cases</a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-page="/Admin/Migration">Migration</a>
                    <a asp-page="/Admin/Audit">Audit</a>
                }
            </nav>
            <div class="header-session">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="who">@User.Identity.Name</span>
                    <form class="inline-form" method="post" asp-page="/Logout">
                        <button type="submit" class="link-button">Sign out</button>
                    </form>
                }
                else
                {
                    <a class="signin" asp-page="/Login">Sign in</a>
                }
            </div>
        </div>
    </header>
    <main class="shell">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <div class="shell">
            Synthetic demonstration environment for an identity migration program. No real agency data.
        </div>
    </footer>
</body>
</html>
