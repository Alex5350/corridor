<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - adfs-sim.corridor.local</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="top-bar">
        <div class="wrap">
            <span class="farm-name">adfs-sim.corridor.local</span>
            <span class="farm-note">Corridor legacy identity provider (simulation)</span>
        </div>
    </header>
    <main class="wrap" id="main-content">
        @RenderBody()
    </main>
    <footer class="footer">
        <div class="wrap">
            <p>Corridor demo environment. All accounts and data are synthetic. This service simulates an on-premises federation server for the ADFS-to-Okta migration walkthrough.</p>
        </div>
    </footer>
</body>
</html>
